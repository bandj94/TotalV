# Copy this file to .env and fill in the values. Never commit .env.

# --- Required ---
# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=
# virustotal.com -> your profile menu -> API key
VT_API_KEY=

# --- Development ---
# Server ID for instant slash-command sync while developing. Blank = global sync.
DEV_GUILD_ID=
# DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOG_LEVEL=INFO

# --- VirusTotal limits (free public API defaults) ---
VT_REQUESTS_PER_MINUTE=4
VT_DAILY_LIMIT=500
# At most 600, because Discord interactions expire after 15 minutes.
# New files often need several minutes on the free API; 600 gives them the most time.
SCAN_TIMEOUT_SECONDS=180
MAX_REPORT_AGE_DAYS=7
MAX_FILE_MB=32
CACHE_TTL_MINUTES=60

# --- Verdict ---
# Number of engines that must flag something as malicious for a MALICIOUS verdict.
MALICIOUS_THRESHOLD=3

# --- Privacy ---
# URLs on these domains are looked up but never submitted for a new scan.
# Comma-separated bare domain names. Leave blank to allow submitting any domain.
NEVER_SUBMIT_DOMAINS=docs.google.com,drive.google.com
